<Project Sdk="Microsoft.NET.Sdk">

  <!--
    §5.6's prompt to expected-criteria suite, two-tier (PLAN.md Phase 2 Step 9):

    OFFLINE tier runs in the default loop, on every PR, at zero cost. It replays each recorded
    model response (evals/recorded/*.json) through the REAL IntentResponseParser, IntentResolver
    and ScreenCriteriaValidator, catching every regression in resolution, vocabulary and scoring
    that has nothing to do with the model itself.

    LIVE tier is gated behind MARKETEYE_AI_EVALS=1 (the same idiom as MARKETEYE_INTEGRATION),
    calls the real provider for all 50 cases, and asserts the >= 85% gate §5.6 and §10 require.
    MARKETEYE_AI_EVALS_RECORD=1 rewrites the recordings the offline tier replays.

    No longer a placeholder: dropping IsTestProject/OutputType lets Directory.Build.props' own
    name-convention rule (*Tests or *Evals) make this a real MTP test project like every other.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarketEye.Domain\MarketEye.Domain.csproj" />
    <ProjectReference Include="..\..\src\MarketEye.Application\MarketEye.Application.csproj" />
    <ProjectReference Include="..\..\src\MarketEye.Infrastructure\MarketEye.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MarketEye.Ai\MarketEye.Ai.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cases and recordings ship as content so they exist next to the built test assembly,
         exactly where the suite reads them from at run time. -->
    <Content Include="evals\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
